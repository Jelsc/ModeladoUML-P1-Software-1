# Local collaborative UML platform settings. Copy to .env and set a private JWT_SECRET.
COMPOSE_PROJECT_NAME=primer-parcial-sw1
PERSISTENCE_BACKEND=mongodb
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=modeladouml
JWT_SECRET=replace-with-a-long-random-secret

APP_ENV=local
CORS_ORIGINS=http://localhost:8080
SEED_DEMO=true
FRONTEND_PORT=8080
BACKEND_PORT=8000
PRODUCTION_FRONTEND_PORT=8081

DEPLOY_GATEWAY_PORT=80
DEPLOY_GATEWAY_HTTPS_PORT=443
DEPLOY_PUBLIC_SCHEME=http
DEPLOY_PUBLIC_DOMAIN=localhost
DEPLOY_CREDENTIAL_SECRET=
GEMINI_API_KEY=

# Configure these for the production gateway and certificate workflow.
FRONTEND_DOMAIN=localhost
API_DOMAIN=localhost
CERTBOT_CERT_NAME=app-primerpacialsw.duckdns.org
CERTBOT_EMAIL=

# The platform database is MongoDB. Generated Spring applications still use PostgreSQL.
