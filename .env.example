POSTGRES_DB=uml_editor
POSTGRES_USER=uml_user
POSTGRES_PASSWORD=local_only_change_me
JWT_SECRET=local-development-secret-change-me
COMPOSE_PROJECT_NAME=primer-parcial-sw1
GEMINI_API_KEY=
BACKEND_PORT=8000
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080
SEED_DEMO=true

# Deployment mode: local keeps the current localhost/HTTP workflow.
# Set APP_ENV=prod and uncomment the production block for the VM.
APP_ENV=local
FRONTEND_DOMAIN=localhost
API_DOMAIN=localhost
CERTBOT_EMAIL=nelsonchumacero755@gmail.com
CERTBOT_CERT_NAME=app-primerpacialsw.duckdns.org

# Generated deployments use api-<slug>.<DEPLOY_PUBLIC_DOMAIN>.
# Locally this preserves api-<slug>.localhost. In production this suffix
# must resolve to the VM (wildcard DNS) and its certificate must cover it.
DEPLOY_PUBLIC_SCHEME=http
DEPLOY_PUBLIC_DOMAIN=localhost
DEPLOY_GATEWAY_PORT=80
DEPLOY_GATEWAY_HTTPS_PORT=443

# VM block: uncomment these values together with APP_ENV=prod.
# FRONTEND_DOMAIN=app-primerpacialsw.duckdns.org
# API_DOMAIN=api-primerpacialsw.duckdns.org
# DEPLOY_PUBLIC_SCHEME=https
# DEPLOY_PUBLIC_DOMAIN=primerpacialsw.duckdns.org
# CERTBOT_CERT_NAME=app-primerpacialsw.duckdns.org